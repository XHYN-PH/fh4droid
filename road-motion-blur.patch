From 0ed4104de3e0dd8eea7631f710ac025128a48de4 Mon Sep 17 00:00:00 2001
From: XHYN-PH <107341607+XHYN-PH@users.noreply.github.com>
Date: Sun, 22 Nov 2026 01:27:08 +0000
Subject: [PATCH] fix(vulkan): use camera motion for the road stencil marker

Adjust the cutoff in the known FH1 velocity shader's constant upload.
Refresh the upload when changing shaders so other draws retain the
guest's original value.

Tests: all 256 stencil values and llvmpipe velocity shader readback.
---
 include/rex/graphics/fh1_motion_blur.h        | 18 ++++++++++++++++
 .../rex/graphics/vulkan/command_processor.h   |  1 +
 src/graphics/vulkan/command_processor.cpp     | 21 +++++++++++++++++++
 3 files changed, 40 insertions(+)
 create mode 100644 include/rex/graphics/fh1_motion_blur.h

diff --git a/include/rex/graphics/fh1_motion_blur.h b/include/rex/graphics/fh1_motion_blur.h
new file mode 100644
index 0000000..efbd829
--- /dev/null
+++ b/include/rex/graphics/fh1_motion_blur.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <bit>
+#include <cstdint>
+
+namespace rex::graphics::fh1_motion_blur {
+
+inline constexpr uint64_t kVelocityShader = 0xE68FE55ECD482EC5;
+inline constexpr uint32_t kStencilCutoffWord = 253 * 4 + 3;
+
+constexpr uint32_t CorrectStencilCutoff(uint32_t original) {
+  // The original cutoff lies above UNORM8 0x80. Road pixels marked by the
+  // stencil-only volume around the car should select camera motion.
+  constexpr uint32_t kGuestCutoff = 0x3F008100;
+  return original == kGuestCutoff ? std::bit_cast<uint32_t>(0.5f) : original;
+}
+
+}  // namespace rex::graphics::fh1_motion_blur
diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
index 043a290..ba453f2 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -1994,6 +1994,7 @@ class VulkanCommandProcessor : public CommandProcessor {
   // Float constant usage masks of the last draw call.
   uint64_t current_float_constant_map_vertex_[4];
   uint64_t current_float_constant_map_pixel_[4];
+  bool current_pixel_constants_correct_blur_stencil_ = false;
 
   // System shader constants.
   SpirvShaderTranslator::SystemConstants system_constants_;
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 5aecec4..18a05e4 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -39,6 +39,7 @@
 #include <rex/thread.h>
 #include <rex/system/xthread.h>
 #include <rex/graphics/fh1_frame_replay.h>
+#include <rex/graphics/fh1_motion_blur.h>
 #if defined(REXGPU_FH1_ORDERED_CENSUS)
 #include <rex/graphics/d3d12/fh1_frame_census.h>
 #endif
@@ -10963,10 +10964,14 @@ bool VulkanCommandProcessor::UpdateBindings(const VulkanShader* vertex_shader,
     }
   }
   uint32_t float_constant_count_pixel = 0;
+  bool correct_blur_stencil = false;
   if (pixel_shader != nullptr) {
     const Shader::ConstantRegisterMap& float_constant_map_pixel =
         pixel_shader->constant_register_map();
     float_constant_count_pixel = float_constant_map_pixel.float_count;
+    correct_blur_stencil = pixel_shader->ucode_data_hash() == fh1_motion_blur::kVelocityShader &&
+                           float_constant_map_pixel.float_dynamic_addressing &&
+                           float_constant_count_pixel == 256;
     for (uint32_t i = 0; i < 4; ++i) {
       if (current_float_constant_map_pixel_[i] != float_constant_map_pixel.float_bitmap[i]) {
         current_float_constant_map_pixel_[i] = float_constant_map_pixel.float_bitmap[i];
@@ -10979,6 +10984,13 @@ bool VulkanCommandProcessor::UpdateBindings(const VulkanShader* vertex_shader,
   } else {
     std::memset(current_float_constant_map_pixel_, 0, sizeof(current_float_constant_map_pixel_));
   }
+  // Another shader may use the same register layout. Upload again when
+  // entering or leaving the velocity pass to keep its correction local.
+  if (current_pixel_constants_correct_blur_stencil_ != correct_blur_stencil) {
+    current_pixel_constants_correct_blur_stencil_ = correct_blur_stencil;
+    current_constant_buffers_up_to_date_ &=
+        ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatPixel);
+  }
 
   // Write the new constant buffers.
   constexpr uint32_t kAllConstantBuffersMask =
@@ -11101,6 +11113,15 @@ bool VulkanCommandProcessor::UpdateBindings(const VulkanShader* vertex_shader,
       buffer_info.range = VkDeviceSize(float_constants_size);
       GatherFloatConstants(mapping, current_float_constant_map_pixel_,
                            &regs.values[XE_GPU_REG_SHADER_CONSTANT_256_X]);
+      if (correct_blur_stencil) {
+        // Relative indexing retains all 256 float vectors in register order.
+        constexpr uint32_t kRegisterWord =
+            XE_GPU_REG_SHADER_CONSTANT_256_X + fh1_motion_blur::kStencilCutoffWord;
+        const uint32_t cutoff =
+            fh1_motion_blur::CorrectStencilCutoff(regs.values[kRegisterWord]);
+        std::memcpy(mapping + sizeof(uint32_t) * fh1_motion_blur::kStencilCutoffWord, &cutoff,
+                    sizeof(cutoff));
+      }
       if (constant_census_enabled_) {
         CountConstantUpload(2, mapping, float_constants_size);
       }


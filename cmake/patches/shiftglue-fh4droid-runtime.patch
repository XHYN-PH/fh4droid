+#if !REX_PLATFORM_WIN32
+bool DiscImageDevice::ReadDescriptor(size_t offset, std::span<uint8_t> output) const {
+  while (!output.empty()) {
+    const ssize_t read = pread(descriptor_, output.data(), output.size(), static_cast<off_t>(offset));
+    if (read < 0 && errno == EINTR) continue;
+    if (read <= 0) return false;
+    offset += static_cast<size_t>(read);
+    output = output.subspan(static_cast<size_t>(read));
+  }
+  return true;
+}
+#endif
 

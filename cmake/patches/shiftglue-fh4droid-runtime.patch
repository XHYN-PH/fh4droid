+bool DiscImageDevice::ReadAt(size_t offset, std::span<uint8_t> output) const {
+  if (offset > image_size_ || output.size() > image_size_ - offset) return false;
+  if (output.empty()) return true;
+  if (mmap_) {
+    std::memcpy(output.data(), mmap_->data() + offset, output.size());
+    return true;
+  }
+#if !REX_PLATFORM_WIN32
+  constexpr size_t kWindow = 64 * 1024;
+  constexpr size_t kSmallRead = 8 * 1024;
+  if (output.size() > kSmallRead) return ReadDescriptor(offset, output);
+  std::lock_guard lock(read_window_mutex_);
+  if (offset >= read_window_offset_) {
+    const size_t start = offset - read_window_offset_;
+    if (start <= read_window_size_ && output.size() <= read_window_size_ - start) {
+      struct stat current {};
+      if (fstat(descriptor_, &current) == 0 && SameDescriptorContents(read_window_source_, current)) {
+        std::memcpy(output.data(), read_window_.get() + start, output.size());
+        return true;
+      }
+      read_window_size_ = 0;
+    }
+  }
+  // Avoid over-reading scattered requests. Once two reads cluster, prefetch
+  // one bounded window from the current offset for subsequent small reads.
+  const size_t distance = offset > last_small_read_end_ ? offset - last_small_read_end_
+                                                       : last_small_read_end_ - offset;
+  const bool nearby = last_small_read_end_ != 0 && distance <= kSmallRead;
+  last_small_read_end_ = offset + output.size();
+  if (!nearby) return ReadDescriptor(offset, output);
+  if (!read_window_) read_window_ = std::make_unique<uint8_t[]>(kWindow);
+  const size_t length = std::min(kWindow, image_size_ - offset);
+  struct stat before {}, after {};
+  if (fstat(descriptor_, &before) != 0 || !S_ISREG(before.st_mode) ||
+      !ReadDescriptor(offset, std::span(read_window_.get(), length)) ||
+      fstat(descriptor_, &after) != 0 || !SameDescriptorContents(before, after)) {
+    read_window_size_ = 0;
+    return ReadDescriptor(offset, output);
+  }
+  read_window_source_ = after;
+  read_window_offset_ = offset;
+  read_window_size_ = length;
+  std::memcpy(output.data(), read_window_.get(), output.size());
+  return true;
+#else
+  return false;
+#endif
+}

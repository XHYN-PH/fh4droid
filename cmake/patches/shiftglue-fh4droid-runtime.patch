diff --git a/include/rex/graphics/fh1_raster_scale.h b/include/rex/graphics/fh1_raster_scale.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/fh1_raster_scale.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <cstdint>
+namespace rex::graphics {
+// Raster surfaces may be smaller than guest EDRAM. Resolves still write the
+// original guest texture layout; only their source coordinate is reduced.
+struct Fh1RasterScale {
+  uint32_t units = 100;  // Integer percentages from 25 to 100
+  explicit constexpr Fh1RasterScale(int percent)
+      : units(percent < 25 ? 25u : percent > 100 ? 100u : uint32_t(percent)) {}
+  constexpr uint32_t Pixels(uint32_t guest, uint32_t integer_scale = 1) const {
+    return uint32_t((uint64_t(guest) * integer_scale * units + 99) / 100);
+  }
+  constexpr int32_t Origin(int32_t guest, uint32_t integer_scale = 1) const {
+    const int64_t n = int64_t(guest) * integer_scale * units;
+    return int32_t(n >= 0 ? n / 100 : -((-n + 99) / 100));
+  }
+  constexpr int32_t End(int32_t guest, uint32_t integer_scale = 1) const {
+    const int64_t n = int64_t(guest) * integer_scale * units;
+    return int32_t(n >= 0 ? (n + 99) / 100 : -((-n) / 100));
+  }
+  // A post-resolve clear must retain the texel shared with the next band.
+  // Resolves sample floor(guest * scale): ceil(end) would erase that texel
+  // before the next band's resolve can read it from the untiled surface.
+  constexpr int32_t ClearEnd(int32_t guest, bool next_band,
+                             uint32_t integer_scale = 1) const {
+    return next_band ? Origin(guest, integer_scale) : End(guest, integer_scale);
+  }
+  // Copy extents use rounded endpoints so offset + extent never exceeds
+  // the rounded attachment size at fractional scales.
+  constexpr uint32_t Span(uint32_t start,uint32_t length,uint32_t integer_scale=1) const {
+    return Pixels(start+length,integer_scale)-Pixels(start,integer_scale);
+  }
+  constexpr uint32_t Code() const { return 100 - units; }
+};
+}

<?xml version="1.0" encoding="utf-8"?>
<!-- Open local game-file setup from the app icon. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="setup"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_setup_short"
        android:shortcutLongLabel="@string/shortcut_setup_long">
        <intent
            android:action="ph.xhyn.fh4droid.SETUP"
            android:targetPackage="ph.xhyn.fh4droid"
            android:targetClass="studio.deimos.pinyonshift.SetupActivity" />
    </shortcut>
</shortcuts>
